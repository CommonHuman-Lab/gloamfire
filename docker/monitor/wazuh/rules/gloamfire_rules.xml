<!-- Gloamfire — custom Wazuh detection rules
     Rule IDs 100001–100099 reserved for Gloamfire.
     These fire on syslog entries written to /var/log/gloamfire/attacks.log
     by the Python attack engine and forwarded by gloamfire-wazuh-agent. -->
<group name="gloamfire,attack_simulation,">

  <!-- Parent rule: any Gloamfire attack event -->
  <rule id="100001" level="8">
    <program_name>Gloamfire</program_name>
    <description>Gloamfire: attack simulation event observed</description>
    <group>gloamfire,</group>
  </rule>

  <rule id="100002" level="12">
    <if_sid>100001</if_sid>
    <match>curl_wget</match>
    <description>Gloamfire: Suspicious remote file download via curl/wget (T1105)</description>
    <mitre><id>T1105</id></mitre>
    <group>gloamfire,ingress_tool_transfer,</group>
  </rule>

  <rule id="100003" level="14">
    <if_sid>100001</if_sid>
    <match>reverse_shell</match>
    <description>Gloamfire: Reverse shell attempt detected (T1059.004)</description>
    <mitre><id>T1059.004</id></mitre>
    <group>gloamfire,reverse_shell,</group>
  </rule>

  <rule id="100004" level="14">
    <if_sid>100001</if_sid>
    <match>fake_ransomware</match>
    <description>Gloamfire: Mass file modification / ransomware activity (T1486)</description>
    <mitre><id>T1486</id></mitre>
    <group>gloamfire,ransomware,</group>
  </rule>

  <rule id="100005" level="12">
    <if_sid>100001</if_sid>
    <match>encoded_command</match>
    <description>Gloamfire: Encoded/obfuscated command execution (T1027)</description>
    <mitre><id>T1027</id></mitre>
    <group>gloamfire,obfuscation,</group>
  </rule>

  <rule id="100006" level="12">
    <if_sid>100001</if_sid>
    <match>persistence</match>
    <description>Gloamfire: Cron-based persistence mechanism installed (T1053.005)</description>
    <mitre><id>T1053.005</id></mitre>
    <group>gloamfire,persistence,</group>
  </rule>

  <rule id="100007" level="10">
    <if_sid>100001</if_sid>
    <match>dns_suspicious</match>
    <description>Gloamfire: Suspicious DNS / DGA beacon activity (T1071.004)</description>
    <mitre><id>T1071.004</id></mitre>
    <group>gloamfire,dns,</group>
  </rule>

  <rule id="100008" level="15">
    <if_sid>100001</if_sid>
    <match>credential_dump</match>
    <description>Gloamfire: OS credential dumping detected — /etc/shadow access (T1003) - CRITICAL</description>
    <mitre><id>T1003</id><id>T1552.001</id></mitre>
    <group>gloamfire,credential_dumping,</group>
  </rule>

  <rule id="100009" level="15">
    <if_sid>100001</if_sid>
    <match>log_tampering</match>
    <description>Gloamfire: Log file tampering / audit trail destruction (T1070.002) - CRITICAL</description>
    <mitre><id>T1070</id><id>T1070.002</id></mitre>
    <group>gloamfire,log_tampering,</group>
  </rule>

  <rule id="100010" level="15">
    <if_sid>100001</if_sid>
    <match>privilege_escalation</match>
    <description>Gloamfire: Privilege escalation attempt — SUID enumeration and sudo probe (T1548) - CRITICAL</description>
    <mitre><id>T1548</id><id>T1548.001</id></mitre>
    <group>gloamfire,privilege_escalation,</group>
  </rule>

  <rule id="100011" level="10">
    <if_sid>100001</if_sid>
    <match>recon</match>
    <description>Gloamfire: Host and network reconnaissance detected (T1082, T1083, T1087, T1016, T1057)</description>
    <mitre><id>T1082</id><id>T1083</id><id>T1087</id><id>T1016</id><id>T1057</id></mitre>
    <group>gloamfire,discovery,</group>
  </rule>

  <rule id="100012" level="12">
    <if_sid>100001</if_sid>
    <match>data_collection</match>
    <description>Gloamfire: Data collection and staging activity detected (T1005, T1074, T1560)</description>
    <mitre><id>T1005</id><id>T1074</id><id>T1560</id></mitre>
    <group>gloamfire,collection,</group>
  </rule>

  <rule id="100013" level="13">
    <if_sid>100001</if_sid>
    <match>exfil_http</match>
    <description>Gloamfire: Data exfiltration over HTTP/DNS detected (T1041, T1048)</description>
    <mitre><id>T1041</id><id>T1048</id></mitre>
    <group>gloamfire,exfiltration,</group>
  </rule>

  <rule id="100014" level="14">
    <if_sid>100001</if_sid>
    <match>account_backdoor</match>
    <description>Gloamfire: Backdoor account creation and manipulation detected (T1136, T1098)</description>
    <mitre><id>T1136</id><id>T1136.001</id><id>T1098</id></mitre>
    <group>gloamfire,persistence,account_creation,</group>
  </rule>

  <rule id="100015" level="12">
    <if_sid>100001</if_sid>
    <match>defense_evasion</match>
    <description>Gloamfire: Defense evasion — history clear, masquerading, permissions modification (T1070.003, T1036, T1222)</description>
    <mitre><id>T1070.003</id><id>T1036</id><id>T1222</id><id>T1562.001</id></mitre>
    <group>gloamfire,defense_evasion,</group>
  </rule>

  <rule id="100017" level="10">
    <if_sid>100001</if_sid>
    <match>network_scan</match>
    <description>Gloamfire: Network and host discovery scan detected (T1046, T1018, T1033)</description>
    <mitre><id>T1046</id><id>T1018</id><id>T1033</id></mitre>
    <group>gloamfire,discovery,</group>
  </rule>

  <rule id="100018" level="11">
    <if_sid>100001</if_sid>
    <match>python_exec</match>
    <description>Gloamfire: Python-based payload execution with base64 decode-and-run (T1059.006, T1140)</description>
    <mitre><id>T1059.006</id><id>T1140</id><id>T1027.002</id></mitre>
    <group>gloamfire,execution,</group>
  </rule>

  <rule id="100019" level="11">
    <if_sid>100001</if_sid>
    <match>c2_icmp</match>
    <description>Gloamfire: ICMP covert C2 channel with data-encoded ping traffic (T1095, T1132)</description>
    <mitre><id>T1095</id><id>T1132</id></mitre>
    <group>gloamfire,command_and_control,</group>
  </rule>

  <rule id="100020" level="12">
    <if_sid>100001</if_sid>
    <match>service_persistence</match>
    <description>Gloamfire: Systemd service persistence unit file written (T1543.002)</description>
    <mitre><id>T1543</id><id>T1543.002</id></mitre>
    <group>gloamfire,persistence,</group>
  </rule>

  <rule id="100021" level="12">
    <if_sid>100001</if_sid>
    <match>env_hijack</match>
    <description>Gloamfire: LD_PRELOAD execution flow hijacking detected (T1574.006)</description>
    <mitre><id>T1574</id><id>T1574.006</id></mitre>
    <group>gloamfire,defense_evasion,privilege_escalation,</group>
  </rule>

  <rule id="100016" level="13">
    <if_sid>100001</if_sid>
    <match>lateral_move</match>
    <description>Gloamfire: Lateral movement detected — SSH probe and tool transfer to pivot host (T1021.004, T1570)</description>
    <mitre><id>T1021</id><id>T1021.004</id><id>T1570</id></mitre>
    <group>gloamfire,lateral_movement,</group>
  </rule>

</group>
